{
  "name": "@lucas8x/pdfy",
  "version": "0.10.0",
  "module": "index.ts",
  "description": "cli tool for converting and compressing a image folder into a single PDF file.",
  "type": "module",
  "private": false,
  "author": "Lucas8x",
  "license": "MIT",
  "bin": {
    "pdfy": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target=node",
    "build:prod": "bun build ./src/index.ts --outdir ./dist --production --target=node",
    "prepack": "bun run build:prod",
    "check": "ultracite check",
    "test": "bun test --parallel --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "fix": "ultracite fix"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@huh-david/bmp-js": "^0.8.8",
    "archiver": "7",
    "archiver-zip-encrypted": "^2.0.0",
    "commander": "^15.1.0",
    "filesize": "^11.0.31",
    "fluent-ffmpeg": "^2.1.3",
    "pdfkit": "^0.19.1",
    "prompts": "^2.4.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/archiver": "7",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/prompts": "^2.4.9",
    "adm-zip": "^0.6.1",
    "typescript": "^7.0.2",
    "ultracite": "8.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lucas8x/pdfy.git"
  },
  "homepage": "https://github.com/Lucas8x/pdfy",
  "bugs": {
    "url": "https://github.com/Lucas8x/pdfy/issues"
  },
  "keywords": [
    "pdf",
    "cli",
    "images",
    "pdfy",
    "transform",
    "convert",
    "compress",
    "cbz"
  ],
  "publishConfig": {
    "access": "public"
  }
}
